{
  "name": "wa-coders-landing",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "start": "astro preview --host",
    "start:dev": "astro dev",
    "start:dev:nocache": "npm run clean && astro dev",
    "dev": "astro dev",
    "clean": "node scripts/clean.mjs",
    "build": "astro build",
    "build:clean": "npm run clean && astro build",
    "build:ghpages": "astro build",
    "preview": "astro preview",
    "deploy": "npm run build:ghpages && gh-pages -d dist -b gh-pages --dotfiles --message \"Deploy WA Coders landing\"",
    "deploy:ssh": "bash ./deploy-ghpages.sh",
    "deploy:dry-run": "npm run build:ghpages && gh-pages -d dist -b gh-pages --dotfiles --no-push"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.2.1",
    "@astrojs/tailwind": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@fontsource/nunito": "^5.1.0",
    "astro": "^4.16.0",
    "tailwindcss": "^3.4.13"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}

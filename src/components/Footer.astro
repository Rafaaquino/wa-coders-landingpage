---
import { localePath, type Locale } from '../i18n/locales';
import { site } from '../site';

interface Props {
  lang: Locale;
  t: any;
  nav: any;
}

const { lang, t, nav } = Astro.props;
const home = localePath(lang);
const year = new Date().getFullYear();
const links = [
  { href: `${home}#services`, label: nav.services },
  { href: `${home}#portfolio`, label: nav.portfolio },
  { href: localePath(lang, 'sap-crm/'), label: nav.sap },
  { href: localePath(lang, 'dynamics-crm/'), label: nav.dynamics },
  { href: localePath(lang, 'privacy/'), label: t.privacy },
];
---

<footer class="border-t border-line bg-surface pb-8 pt-14">
  <div class="mx-auto max-w-container px-6 md:px-10">
    <div class="flex flex-wrap justify-between gap-10">
      <div>
        <a href={home} class="flex items-center gap-2 font-display text-lg font-black text-ink">
          <img src={site.logo} alt="WA Coders" width="32" height="32" class="h-8 w-8" loading="lazy" />WA Coders
        </a>
        <p class="mt-2.5 max-w-[34ch] text-[13.5px] text-muted">{t.tagline}</p>
      </div>

      <div class="flex flex-wrap gap-12">
        <nav aria-label={t.company}>
          <p class="mb-3 font-body text-xs font-semibold uppercase tracking-wider text-muted">{t.company}</p>
          {links.map((l) => <a href={l.href} class="mb-2 block text-[13.5px] text-ink hover:text-accent-text">{l.label}</a>)}
        </nav>
        <div>
          <p class="mb-3 font-body text-xs font-semibold uppercase tracking-wider text-muted">{t.contactLabel}</p>
          <a href={`mailto:${site.email}`} class="mb-2 block text-[13.5px] text-ink hover:text-accent-text">{site.email}</a>
          <a data-wa href={site.whatsapp} target="_blank" rel="noopener" class="mb-2 block text-[13.5px] text-ink hover:text-accent-text">{t.whatsappLabel} {site.phoneDisplay}</a>
        </div>
        <address class="not-italic">
          <p class="mb-3 font-body text-xs font-semibold uppercase tracking-wider text-muted">{t.offices}</p>
          <p class="mb-2 max-w-[28ch] text-[13.5px] text-ink">Miami — {site.offices.miami.line}</p>
          <p class="mb-2 max-w-[28ch] text-[13.5px] text-ink">São Paulo — {site.offices.saoPaulo.line}</p>
        </address>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line pt-5 text-xs text-muted">
      <span>© {year} {site.name}. {t.rights}</span>
      <button type="button" data-consent-open class="hover:text-ink">{t.cookies}</button>
    </div>
  </div>
</footer>

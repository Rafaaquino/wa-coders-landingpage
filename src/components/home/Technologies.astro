---
import { technologies } from '../../site';
import { pngSize } from '../../lib/image-size';

interface Props { t: any }
const { t } = Astro.props;
---

<section id="tech" class="bg-surface py-24">
  <div class="mx-auto max-w-container px-6 md:px-10">
    <p class="mb-3.5 font-mono text-xs uppercase tracking-wider text-accent2">{t.eyebrow}</p>
    <h2 class="max-w-[26ch] text-[32px]">{t.title}</h2>
    <p class="mt-3.5 max-w-[62ch] text-[15.5px] text-muted">{t.subtitle}</p>

    <ul class="mt-11 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {
        technologies.map((tech) => (
          <li class="flex h-24 items-center justify-center rounded-xl border border-line bg-white p-3 transition hover:-translate-y-1 hover:shadow-[0_14px_30px_-18px_rgba(14,23,38,0.35)]">
            {'file' in tech ? (
              tech.withName ? (
                <span class="flex items-center gap-2">
                  <img src={`/tech/${tech.file}`} alt="" width="28" height="28" class="h-7 w-7 flex-shrink-0" loading="lazy" decoding="async" />
                  <span class="font-display text-[15px] font-extrabold text-ink">{tech.name}</span>
                </span>
              ) : (
                <img src={`/tech/${tech.file}`} alt={tech.name} width={pngSize(`tech/${tech.file}`).width} height={pngSize(`tech/${tech.file}`).height} class="max-h-12 max-w-full object-contain" loading="lazy" decoding="async" />
              )
            ) : (
              <span class="text-center" aria-label={tech.name}>
                <span class="block font-display text-[16px] font-black leading-tight whitespace-nowrap" style={`color:${tech.color}`}>{tech.text}</span>
                <span class="block text-[11px] font-medium text-muted">{tech.sub}</span>
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

---
import { technologies } from '../../site';

interface Props { t: any }
const { t } = Astro.props;
---

<section id="tech" class="bg-surface py-24">
  <div class="mx-auto max-w-container px-6 md:px-10">
    <p class="mb-3.5 font-mono text-xs uppercase tracking-wider text-accent2">{t.eyebrow}</p>
    <h2 class="max-w-[26ch] text-[32px]">{t.title}</h2>
    <p class="mt-3.5 max-w-[62ch] text-[15.5px] text-muted">{t.subtitle}</p>

    <ul class="mt-11 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {
        technologies.map((tech) => (
          <li class="flex h-24 items-center justify-center rounded-xl border border-line bg-white p-4 transition hover:-translate-y-1 hover:shadow-[0_14px_30px_-18px_rgba(14,23,38,0.35)]">
            <img src={`/tech/${tech.file}`} alt={tech.name} class="max-h-12 max-w-full object-contain" loading="lazy" decoding="async" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

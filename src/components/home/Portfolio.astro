---
import { localePath, type Locale } from '../../i18n/locales';

interface Props { t: any; lang: Locale }
const { t, lang } = Astro.props;
---

<section id="portfolio" class="bg-surface py-24">
  <div class="mx-auto max-w-container px-6 md:px-10">
    <p class="mb-3.5 font-mono text-xs uppercase tracking-wider text-accent2">{t.eyebrow}</p>
    <h2 class="max-w-[22ch] text-[32px]">{t.title}</h2>
    <p class="mt-3.5 max-w-[62ch] text-[15.5px] text-muted">{t.subtitle}</p>

    <div class="mt-11 grid gap-6 lg:grid-cols-3">
      {
        t.items.map((p: any) => (
          <article class="flex flex-col rounded-xl border border-line bg-white p-7">
            <div class="mb-5 flex items-center justify-between gap-3">
              {p.key === 'upsee' ? (
                <span class="flex h-11 items-center rounded-lg bg-ink px-3">
                  <img src="/portfolio/upsee-logo.png" alt="Upsee" width="476" height="147" class="h-7 w-auto" loading="lazy" />
                </span>
              ) : (
                <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-ink font-display text-xl font-black text-accent" aria-hidden="true">{p.name[0]}</span>
              )}
              <span class="rounded-full border border-line bg-surface px-3 py-1 font-mono text-[11px] uppercase tracking-wider text-muted">{p.category}</span>
            </div>
            <h3 class="text-xl font-extrabold">{p.name}</h3>
            <p class="mb-3 mt-0.5 text-sm font-semibold text-accent-text">{p.tagline}</p>
            <p class="flex-1 text-sm text-muted">{p.desc}</p>
            <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-semibold">
              <a href={p.url} target="_blank" rel="noopener" class="text-ink underline decoration-accent decoration-2 underline-offset-4 hover:text-accent-text">
                {t.visit} <span class="sr-only">— {p.name}</span> ↗
              </a>
              {p.internal && (
                <a href={localePath(lang, 'sap-crm/')} class="text-accent2 hover:underline">{t.sapLink} →</a>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-10 text-center text-[15px] font-medium">
      {t.cta}
      <a href="#contact" class="ml-1 text-accent-text underline underline-offset-4">→</a>
    </p>
  </div>
</section>

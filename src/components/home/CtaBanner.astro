---
import { site } from '../../site';

interface Props { t: any }
const { t } = Astro.props;
---

<section class="bg-ink py-20 text-white">
  <div class="mx-auto flex max-w-container flex-wrap items-center justify-between gap-8 px-6 md:px-10">
    <div class="max-w-[56ch]">
      <h2 class="text-[28px] text-white md:text-[32px]">{t.title}</h2>
      <p class="mt-3 text-[16px] text-white/70">{t.subtitle}</p>
    </div>
    <div class="flex flex-wrap items-center gap-4">
      <a href="#contact" class="rounded-lg bg-accent px-6 py-3.5 text-sm font-semibold text-ink shadow-sm transition hover:-translate-y-px hover:bg-accent-hover hover:shadow-md">{t.button}</a>
      <a href={site.whatsapp} target="_blank" rel="noopener" class="rounded-lg border border-white/25 px-6 py-3.5 text-sm font-semibold text-white transition hover:border-white/60">{t.whatsapp}</a>
    </div>
  </div>
</section>

---
import { localePath, type Locale } from '../../i18n/locales';

interface Props { t: any; lang: Locale }
const { t, lang } = Astro.props;

const icons = [
  'M4 20V10M12 20V4M20 20v-7',
  'M3 6h18v13H3zM3 10h18M7 15h4',
  'M16 20v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2M9.5 10a3.5 3.5 0 100-7 3.5 3.5 0 000 7z',
  'M4 19V6a2 2 0 012-2h7l5 5v10a2 2 0 01-2 2H6a2 2 0 01-2-2zM13 4v5h5',
];
---

<section id="sap" class="bg-accent2-tint py-24">
  <div class="mx-auto grid grid-cols-1 max-w-container gap-12 px-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:items-center md:gap-14 md:px-10">
    <div>
      <p class="mb-3.5 font-mono text-xs uppercase tracking-wider text-accent2">{t.eyebrow}</p>
      <h2 class="text-[1.9rem] leading-[1.2] md:text-[2.2rem]">{t.title}</h2>
      <p class="mt-3.5 font-semibold text-ink">{t.subtitle}</p>
      <p class="mt-3 text-[15.5px] text-muted">{t.desc}</p>
      <p class="mt-5 inline-block rounded-full border border-accent2/30 bg-white px-4 py-1.5 text-[13px] font-semibold text-accent2">{t.badge}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href={localePath(lang, 'sap-crm/')} class="rounded-lg bg-accent px-6 py-3.5 text-sm font-semibold text-ink shadow-sm transition hover:-translate-y-px hover:bg-accent-hover hover:shadow-md">{t.ctaPage}</a>
        <a href="#contact" class="text-sm font-semibold text-ink underline decoration-accent decoration-2 underline-offset-4">{t.cta}</a>
      </div>
    </div>

    <ul class="grid gap-4 sm:grid-cols-2">
      {
        t.items.map((item: { title: string; desc: string }, i: number) => (
          <li class="rounded-xl border border-accent2/20 bg-white p-5">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="mb-3 h-6 w-6 text-accent2" aria-hidden="true">
              <path d={icons[i]} />
            </svg>
            <h3 class="mb-1 text-[15.5px] font-extrabold">{item.title}</h3>
            <p class="text-[13.6px] text-muted">{item.desc}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

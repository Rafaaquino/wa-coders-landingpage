---
import { site } from '../../site';
import { localePath, type Locale } from '../../i18n/locales';

interface Props { t: any; lang: Locale }
const { t, lang } = Astro.props;
const f = t.form;

// Valores enviados ao backend ficam em inglês (contrato atual do e-mail interno).
const subjects = [
  { value: 'Custom Software Development', label: f.subjectLabels.custom },
  { value: 'Website', label: f.subjectLabels.website },
  { value: 'Mobile App Development', label: f.subjectLabels.mobile },
  { value: 'Dedicated Development Team', label: f.subjectLabels.team },
  { value: 'UX/UI Design and Branding', label: f.subjectLabels.design },
  { value: 'Integrations and Modernization', label: f.subjectLabels.integrations },
  { value: 'SAP/CRM Customization', label: f.subjectLabels.sap },
  { value: 'Dynamics/CRM Customization', label: f.subjectLabels.dynamics },
  { value: 'AI, Chatbot and RAG', label: f.subjectLabels.ai },
  { value: 'Others', label: f.subjectLabels.other },
];
const input = 'w-full rounded-lg border border-line bg-white px-3.5 py-2.5 text-[14.5px] focus:border-accent focus:outline-none focus:ring-4 focus:ring-accent-tint';
---

<section id="contact" class="py-24">
  <div class="mx-auto grid grid-cols-1 max-w-container gap-12 px-6 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] md:gap-16 md:px-10">
    <div>
      <p class="mb-3.5 font-mono text-xs uppercase tracking-wider text-accent2">{t.eyebrow}</p>
      <h2 class="text-[32px]">{t.title}</h2>
      <p class="mt-3.5 max-w-[56ch] text-[15.5px] text-muted">{t.subtitle}</p>

      <address class="mt-9 flex flex-col gap-5 not-italic">
        <div>
          <h3 class="font-body text-xs font-semibold uppercase tracking-wider text-muted">{t.office1}</h3>
          <p class="mt-1 text-[15px]">{site.offices.miami.line}</p>
        </div>
        <div>
          <h3 class="font-body text-xs font-semibold uppercase tracking-wider text-muted">{t.office2}</h3>
          <p class="mt-1 text-[15px]">{site.offices.saoPaulo.line}</p>
        </div>
        <div>
          <h3 class="font-body text-xs font-semibold uppercase tracking-wider text-muted">{t.hours}</h3>
          <p class="mt-1 text-[15px]">{t.hoursValue}</p>
        </div>
        <div>
          <h3 class="font-body text-xs font-semibold uppercase tracking-wider text-muted">{t.email}</h3>
          <p class="mt-1 text-[15px]"><a href={`mailto:${site.email}`} class="underline decoration-accent decoration-2 underline-offset-4">{site.email}</a></p>
        </div>
        <div>
          <h3 class="font-body text-xs font-semibold uppercase tracking-wider text-muted">{t.whatsapp}</h3>
          <p class="mt-1 text-[15px]"><a href={site.whatsapp} target="_blank" rel="noopener" class="underline decoration-accent decoration-2 underline-offset-4">{site.phoneDisplay}</a></p>
        </div>
      </address>
    </div>

    <form id="contact-form" data-api-form data-sending={f.sending} data-success={f.success} data-error={f.error} class="rounded-2xl border border-line bg-surface p-7">
      <div class="mb-3.5">
        <label class="mb-1.5 block text-xs font-semibold" for="c-name">{f.name}</label>
        <input class={input} type="text" id="c-name" name="name" autocomplete="name" required />
      </div>
      <div class="mb-3.5">
        <label class="mb-1.5 block text-xs font-semibold" for="c-email">{f.email}</label>
        <input class={input} type="email" id="c-email" name="email" autocomplete="email" required />
      </div>
      <div class="mb-3.5">
        <label class="mb-1.5 block text-xs font-semibold" for="c-subject">{f.subject}</label>
        <select class={input} id="c-subject" name="subject" required>
          <option value="" selected disabled>{f.subjectPlaceholder}</option>
          {subjects.map((s) => <option value={s.value}>{s.label}</option>)}
        </select>
      </div>
      <div class="mb-5">
        <label class="mb-1.5 block text-xs font-semibold" for="c-message">{f.message}</label>
        <textarea class={`${input} resize-none`} id="c-message" name="message" rows="5" required></textarea>
      </div>
      <button type="submit" class="w-full rounded-lg bg-accent px-4 py-3.5 text-center text-sm font-semibold text-ink shadow-sm transition hover:-translate-y-px hover:bg-accent-hover hover:shadow-md disabled:opacity-60">{f.send}</button>
      <p class="mt-3 text-[12.5px] leading-relaxed text-muted">{f.privacyPre}<a href={localePath(lang, 'privacy/')} class="font-semibold text-ink underline decoration-accent decoration-2 underline-offset-4">{f.privacyLink}</a>{f.privacyPost}</p>
      <p data-form-status role="status" aria-live="polite" class="mt-3 text-sm"></p>
    </form>
  </div>
</section>

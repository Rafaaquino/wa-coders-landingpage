---
interface Props { t: any }
const { t } = Astro.props;

const icons = [
  'M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z',
  'M4 5.5c0 1.66 3.58 3 8 3s8-1.34 8-3-3.58-3-8-3-8 1.34-8 3zM4 5.5v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6M4 11.5v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6',
  'M10 13a5 5 0 007 0l3-3a5 5 0 00-7-7l-1 1M14 11a5 5 0 00-7 0l-3 3a5 5 0 007 7l1-1',
  'M3 12a9 9 0 0115.5-6.2L21 8M21 3v5h-5M21 12a9 9 0 01-15.5 6.2L3 16M3 21v-5h5',
];
---

<section id="ai" class="bg-ink py-24 text-white">
  <div class="mx-auto max-w-container px-6 md:px-10">
    <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:gap-14">
      <div>
        <p class="mb-3.5 font-mono text-xs uppercase tracking-wider text-accent">{t.eyebrow}</p>
        <h2 class="max-w-[22ch] text-[1.9rem] leading-[1.2] text-white md:text-[2.4rem]">{t.title}</h2>
        <p class="mt-4 max-w-[58ch] text-[16px] text-white/70">{t.lede}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href="#contact" class="rounded-lg bg-accent px-6 py-3.5 text-sm font-semibold text-ink shadow-sm transition hover:-translate-y-px hover:bg-accent-hover hover:shadow-md">{t.cta}</a>
          <p class="text-[13.5px] text-white/60">
            {t.proof} <a href="#portfolio" class="font-semibold text-white underline decoration-accent decoration-2 underline-offset-4">{t.proofLink}</a>
          </p>
        </div>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/5 p-6 md:p-8">
        <p class="font-mono text-[11px] uppercase tracking-wider text-white/50">{t.flowTitle}</p>
        <ol class="mt-5 flex flex-col gap-2.5">
          {
            t.flow.map((step: string, i: number) => (
              <li>
                <div class={`flex items-center gap-3 rounded-xl border px-4 py-3 text-[14px] font-semibold ${i === t.flow.length - 1 ? 'border-accent bg-accent text-ink' : 'border-white/15 bg-white/5 text-white'}`}>
                  <span class={`flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full font-mono text-[11px] ${i === t.flow.length - 1 ? 'bg-ink text-accent' : 'bg-white/10 text-white/70'}`}>{i + 1}</span>
                  {step}
                </div>
                {i < t.flow.length - 1 && <div aria-hidden="true" class="py-0.5 pl-[1.15rem] text-accent">↓</div>}
              </li>
            ))
          }
        </ol>
        <p class="mt-5 text-[13px] leading-relaxed text-white/60">{t.flowCaption}</p>
      </div>
    </div>

    <ul class="mt-14 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.items.map((item: { title: string; desc: string }, i: number) => (
          <li class="rounded-xl border border-white/10 bg-white/5 p-5">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="mb-3 h-6 w-6 text-accent">
              <path d={icons[i]} />
            </svg>
            <h3 class="mb-1.5 text-[15.5px] font-extrabold text-white">{item.title}</h3>
            <p class="text-[13.6px] text-white/65">{item.desc}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

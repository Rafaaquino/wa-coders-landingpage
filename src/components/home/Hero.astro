---
import { site } from '../../site';

interface Props { t: any; portfolio: any }
const { t, portfolio } = Astro.props;
const products = portfolio.items;
---

<section class="pb-24 pt-14 md:pt-20">
  <div class="mx-auto grid max-w-container gap-12 px-6 md:grid-cols-[1.05fr_1fr] md:items-center md:gap-14 md:px-10">
    <div>
      <p class="mb-3.5 font-mono text-xs uppercase tracking-wider text-accent2">{t.eyebrow}</p>
      <h1 class="text-[2.15rem] leading-[1.14] md:text-[2.85rem]">{t.title}</h1>
      <p class="mt-3.5 max-w-[56ch] text-lg text-muted">{t.lede}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="#contact" class="rounded-lg bg-accent px-6 py-3.5 text-sm font-semibold text-ink shadow-sm transition hover:-translate-y-px hover:bg-accent-hover hover:shadow-md">{t.ctaPrimary}</a>
        <a href="#services" class="rounded-lg border border-line bg-white px-6 py-3.5 text-sm font-semibold text-ink transition hover:border-muted">{t.ctaSecondary}</a>
      </div>
      <ul class="mt-7 flex flex-col gap-2 text-[13.5px] text-muted">
        {
          t.trust.map((item: string) => (
            <li class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 flex-shrink-0 text-success" aria-hidden="true">
                <circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.5 2.5L16 9" />
              </svg>
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <div class="overflow-hidden rounded-2xl border border-line bg-white shadow-[0_24px_60px_-20px_rgba(14,23,38,0.25)]">
        <div class="flex items-center gap-2 border-b border-line bg-surface px-3.5 py-2.5">
          <span class="h-2.5 w-2.5 rounded-full" style="background:#e7515a"></span>
          <span class="h-2.5 w-2.5 rounded-full" style="background:#e2a03f"></span>
          <span class="h-2.5 w-2.5 rounded-full" style="background:#00ab55"></span>
          <span class="ml-2.5 rounded-md border border-line bg-white px-3 py-1 font-mono text-[11.5px] text-muted">{t.mockUrl}</span>
        </div>
        <div class="p-5">
          <p class="mb-3 font-mono text-[11px] uppercase tracking-wider text-muted">{t.mockTitle}</p>
          <ul class="flex flex-col gap-2.5">
            {
              products.map((p: any) => (
                <li class="flex items-center justify-between gap-3 rounded-lg border border-line bg-surface p-3.5">
                  <div class="flex min-w-0 items-center gap-3">
                    <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-ink font-display text-sm font-black text-accent" aria-hidden="true">{p.name[0]}</span>
                    <div class="min-w-0">
                      <div class="font-display text-[15px] font-extrabold">{p.name}</div>
                      <div class="truncate text-xs text-muted">{p.tagline}</div>
                    </div>
                  </div>
                  <span class="flex-shrink-0 rounded-full bg-success-tint px-2.5 py-0.5 text-[10px] font-semibold text-success-text">{t.mockStatus}</span>
                </li>
              ))
            }
          </ul>
          <p class="mb-2 mt-5 font-mono text-[11px] uppercase tracking-wider text-muted">{t.mockOffices}</p>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="rounded-lg border border-line bg-surface p-3.5">
              <div class="font-display text-[15px] font-extrabold">Miami, FL</div>
              <div class="mt-0.5 text-xs text-muted">{site.offices.miami.street}</div>
            </div>
            <div class="rounded-lg border border-line bg-surface p-3.5">
              <div class="font-display text-[15px] font-extrabold">São Paulo, SP</div>
              <div class="mt-0.5 text-xs text-muted">{site.offices.saoPaulo.street}</div>
            </div>
          </div>
        </div>
      </div>
      <p class="mt-3.5 text-center text-xs italic text-muted">{t.caption}</p>
    </div>
  </div>
</section>

---
interface Props { t: any }
const { t } = Astro.props;
---

<section id="why" class="py-24">
  <div class="mx-auto max-w-container px-6 md:px-10">
    <p class="mb-3.5 font-mono text-xs uppercase tracking-wider text-accent2">{t.eyebrow}</p>

    <div class="grid grid-cols-1 items-start gap-10 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] md:gap-14">
      <div>
        <h2 class="text-[2rem] leading-[1.2] md:text-[2.25rem]">{t.title}</h2>
        <p class="mt-4 text-[15.5px] text-muted">{t.desc}</p>
        <a href="#contact" class="mt-7 inline-block rounded-lg bg-accent px-6 py-3.5 text-sm font-semibold text-ink shadow-sm transition hover:-translate-y-px hover:bg-accent-hover hover:shadow-md">{t.cta}</a>
      </div>

      <ul class="flex flex-col gap-4.5">
        {
          t.items.map((item: string) => (
            <li class="flex items-start gap-3.5 text-[15.5px]">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-5 w-5 flex-shrink-0 text-success" aria-hidden="true">
                <circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.5 2.5L16 9" />
              </svg>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

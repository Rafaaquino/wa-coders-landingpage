---
interface Props { t: any }
const { t } = Astro.props;

const icons = [
  'M8 8l-4 4 4 4M16 8l4 4-4 4M14 5l-4 14',
  'M3 4h18v12H3zM8 20h8M12 16v4',
  'M7 2h10v20H7zM11 18h2',
  'M16 20v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2M9.5 10a3.5 3.5 0 100-7 3.5 3.5 0 000 7zM21 20v-2a4 4 0 00-3-3.9M16 3.1a3.5 3.5 0 010 6.8',
  'M12 20h9M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z',
  'M10 13a5 5 0 007 0l3-3a5 5 0 00-7-7l-1 1M14 11a5 5 0 00-7 0l-3 3a5 5 0 007 7l1-1',
];
---

<section id="services" class="bg-surface py-24">
  <div class="mx-auto max-w-container px-6 md:px-10">
    <p class="mb-3.5 font-mono text-xs uppercase tracking-wider text-accent2">{t.eyebrow}</p>
    <h2 class="max-w-[26ch] text-[32px]">{t.title}</h2>
    <p class="mt-3.5 max-w-[68ch] text-[15.5px] text-muted">{t.subtitle}</p>

    <div class="mt-11 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.items.map((item: { title: string; desc: string }, i: number) => (
          <article class="rounded-xl border border-line bg-white p-6 transition hover:-translate-y-1 hover:shadow-[0_14px_30px_-18px_rgba(14,23,38,0.35)]">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="mb-3.5 h-6 w-6 text-accent2" aria-hidden="true">
              <path d={icons[i]} />
            </svg>
            <h3 class="mb-1.5 text-[16.5px] font-extrabold">{item.title}</h3>
            <p class="text-[13.8px] text-muted">{item.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

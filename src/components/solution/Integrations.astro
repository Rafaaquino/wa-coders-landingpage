---
interface Props { t: any }
const { t } = Astro.props;

const icons = [
  'M3 6h18v13H3zM3 10h18M7 15h4',
  'M3 5h18l-7 8v6l-4 2v-8z',
];
---

<section id="integracoes" class="py-24">
  <div class="mx-auto max-w-container px-6 md:px-10">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="mb-3.5 font-mono text-xs uppercase tracking-wider text-accent2">{t.eyebrow}</p>
        <h2 class="max-w-[28ch] text-[32px]">{t.title}</h2>
      </div>
      <span class="rounded-full border border-line bg-surface px-3 py-1.5 text-xs font-medium text-muted">{t.badge}</span>
    </div>

    <div class="mt-11 grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        t.items.map((item: { tag: string; title: string; desc: string; flow: string }, i: number) => (
          <article class="rounded-xl border border-line bg-surface p-7">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="mb-4 h-6 w-6 text-accent2">
              <path d={icons[i]} />
            </svg>
            <p class="mb-2 font-mono text-[11px] uppercase tracking-wider text-accent2">{item.tag}</p>
            <h3 class="mb-2 text-lg font-extrabold">{item.title}</h3>
            <p class="text-sm text-muted">{item.desc}</p>
            <p class="mt-4 font-mono text-xs text-ink">{item.flow}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

---
interface Props { t: any }
const { t } = Astro.props;

const icons = [
  'M3 4h18v16H3zM3 9h18M9 9v11',
  'M2 9h7v7H2zM15 9h7v7h-7zM9 12.5h6M5 6l14 14',
  'M3 6l9 6 9-6M3 5h18v14H3zM18 16a4.2 4.2 0 100-8.4 4.2 4.2 0 000 8.4zM18 14.3v1.9l1.3 1',
];
---

<section class="bg-surface py-24">
  <div class="mx-auto max-w-container px-6 md:px-10">
    <p class="mb-3.5 font-mono text-xs uppercase tracking-wider text-accent2">{t.eyebrow}</p>
    <h2 class="max-w-[22ch] text-[32px]">{t.title}</h2>

    <div class="mt-11 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.items.map((item: { title: string; desc: string }, i: number) => (
          <div class="rounded-xl border border-line bg-white p-6">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="mb-4 h-6 w-6 text-accent">
              <path d={icons[i]} />
            </svg>
            <h3 class="mb-2 text-[16.5px] font-extrabold">{item.title}</h3>
            <p class="text-sm text-muted">{item.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

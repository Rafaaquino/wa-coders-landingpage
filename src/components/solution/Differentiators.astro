---
interface Props { t: any }
const { t } = Astro.props;
---

<section id="diferenciais" class="py-24">
  <div class="mx-auto max-w-container px-6 md:px-10">
    <p class="mb-3.5 font-mono text-xs uppercase tracking-wider text-accent2">{t.eyebrow}</p>

    <div class="grid grid-cols-1 items-center gap-8 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] md:gap-14">
      <p class="text-[26px] leading-[1.35]">
        {t.headlinePre}<span class="text-accent2">{t.headlineAccent}</span>{t.headlinePost}
      </p>

      <ul class="flex flex-col gap-4.5">
        {
          t.items.map((item: { bold: string; rest: string }) => (
            <li class="flex items-start gap-3.5 text-[15.5px]">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-5 w-5 flex-shrink-0 text-success">
                <circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.5 2.5L16 9" />
              </svg>
              <span><b class="font-bold">{item.bold}</b> — {item.rest}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

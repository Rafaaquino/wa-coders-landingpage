---
interface Props { t: any }
const { t } = Astro.props;
---

<section id="faq" class="py-24">
  <div class="mx-auto max-w-container px-6 md:px-10">
    <p class="mb-3.5 font-mono text-xs uppercase tracking-wider text-accent2">{t.eyebrow}</p>
    <h2 class="max-w-[30ch] text-[28px]">{t.title}</h2>

    <div class="mt-10 flex flex-col">
      {
        t.items.map((item: { q: string; a: string }, i: number) => (
          <div class={`border-b border-line py-6 ${i === 0 ? 'border-t' : ''}`}>
            <h3 class="mb-2 font-display text-base font-bold">{item.q}</h3>
            <p class="max-w-[68ch] text-[14.5px] text-muted">{item.a}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

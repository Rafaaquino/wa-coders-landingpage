---
interface Props { t: any }
const { t } = Astro.props;

const icons = [
  'M3 5h18l-7 8v6l-4 2v-8z',
  'M3 6h18v13H3zM3 10h18M7 15h4',
  'M4 19V6a2 2 0 012-2h7l5 5v10a2 2 0 01-2 2H6a2 2 0 01-2-2zM13 4v5h5',
  'M12 21a9 9 0 100-18M12 12l5-3M12 12v6',
  'M12 12a9 9 0 100-18 9 9 0 000 18zM12 7v5l3.5 2',
  'M4 20V10M12 20V4M20 20v-7',
];
---

<section id="modulos" class="bg-surface py-24">
  <div class="mx-auto max-w-container px-6 md:px-10">
    <p class="mb-3.5 font-mono text-xs uppercase tracking-wider text-accent2">{t.eyebrow}</p>
    <h2 class="max-w-[24ch] text-[32px]">{t.title}</h2>

    <div class="mt-11 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.items.map((item: { title: string; desc: string }, i: number) => (
          <div class="rounded-xl border border-line bg-white p-6 transition hover:-translate-y-1 hover:shadow-[0_14px_30px_-18px_rgba(14,23,38,0.35)]">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="mb-3.5 h-6 w-6 text-accent2">
              <path d={icons[i]} />
            </svg>
            <h3 class="mb-1.5 text-[15.5px] font-extrabold">{item.title}</h3>
            <p class="text-[13.6px] text-muted">{item.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

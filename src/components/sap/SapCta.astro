---
interface Props { t: any; msgs: any }
const { t, msgs } = Astro.props;
const form = t.form;
const input = 'w-full rounded-lg border border-line bg-white px-3.5 py-2.5 text-[14.5px] focus:border-accent focus:outline-none focus:ring-4 focus:ring-accent-tint';
---

<section id="cta" class="bg-ink py-24 text-white">
  <div class="mx-auto grid max-w-container gap-12 px-6 md:grid-cols-2 md:items-start md:gap-16 md:px-10">
    <div>
      <p class="mb-3.5 font-mono text-xs uppercase tracking-wider text-accent">{t.eyebrow}</p>
      <h2 class="max-w-[18ch] text-[32px] text-white">{t.title}</h2>
      <p class="mt-3.5 max-w-[56ch] text-lg text-white/70">{t.lede}</p>
      <ul class="mt-8 flex flex-col gap-3.5">
        {
          t.bullets.map((bullet: string) => (
            <li class="flex items-start gap-3 text-[14.5px] text-white/80">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-4.5 w-4.5 flex-shrink-0 text-accent">
                <circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.5 2.5L16 9" />
              </svg>
              {bullet}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="rounded-2xl bg-white p-8 text-ink">
      <form id="sap-form" data-api-form data-sending={msgs.sending} data-success={msgs.success} data-error={msgs.error}>
        <input type="hidden" name="subject" value={t.subject} />
        <div class="mb-3.5 grid gap-3.5 sm:grid-cols-2">
          <div>
            <label class="mb-1.5 block text-xs font-semibold" for="s-name">{form.nameLabel}</label>
            <input class={input} type="text" id="s-name" name="name" autocomplete="name" placeholder={form.namePlaceholder} required />
          </div>
          <div>
            <label class="mb-1.5 block text-xs font-semibold" for="s-company">{form.companyLabel}</label>
            <input class={input} type="text" id="s-company" name="company" data-field-label={form.companyLabel} autocomplete="organization" placeholder={form.companyPlaceholder} required />
          </div>
        </div>
        <div class="mb-3.5 grid gap-3.5 sm:grid-cols-2">
          <div>
            <label class="mb-1.5 block text-xs font-semibold" for="s-role">{form.roleLabel}</label>
            <input class={input} type="text" id="s-role" name="role" data-field-label={form.roleLabel} autocomplete="organization-title" placeholder={form.rolePlaceholder} />
          </div>
          <div>
            <label class="mb-1.5 block text-xs font-semibold" for="s-phone">{form.phoneLabel}</label>
            <input class={input} type="tel" id="s-phone" name="phone" data-field-label={form.phoneLabel} autocomplete="tel" placeholder={form.phonePlaceholder} required />
          </div>
        </div>
        <div class="mb-3.5">
          <label class="mb-1.5 block text-xs font-semibold" for="s-email">{form.emailLabel}</label>
          <input class={input} type="email" id="s-email" name="email" autocomplete="email" placeholder={form.emailPlaceholder} required />
        </div>
        <div class="mb-3.5 grid gap-3.5 sm:grid-cols-2">
          <div>
            <label class="mb-1.5 block text-xs font-semibold" for="s-sap">{form.sapLabel}</label>
            <select class={input} id="s-sap" name="sap_status" data-field-label={form.sapLabel} required>
              {form.sapOptions.map((opt: string, i: number) => <option value={i === 0 ? '' : opt} selected={i === 0} disabled={i === 0}>{opt}</option>)}
            </select>
          </div>
          <div>
            <label class="mb-1.5 block text-xs font-semibold" for="s-interest">{form.subjectLabel}</label>
            <select class={input} id="s-interest" name="interest" data-field-label={form.subjectLabel} required>
              {form.subjectOptions.map((opt: string, i: number) => <option value={i === 0 ? '' : opt} selected={i === 0} disabled={i === 0}>{opt}</option>)}
            </select>
          </div>
        </div>
        <div class="mb-3.5">
          <label class="mb-1.5 block text-xs font-semibold" for="s-message">{form.messageLabel}</label>
          <textarea class={`${input} resize-none`} id="s-message" name="message" rows="3" placeholder={form.messagePlaceholder}></textarea>
        </div>
        <div class="mb-5 mt-4.5 flex items-start gap-2.5">
          <input class="mt-0.5 h-4 w-4 flex-shrink-0" type="checkbox" id="s-consent" name="consent" required />
          <label class="text-[12.5px] leading-relaxed text-muted" for="s-consent">{form.consent}</label>
        </div>
        <button type="submit" class="w-full rounded-lg bg-accent px-4 py-3.5 text-center text-sm font-semibold text-ink shadow-sm transition hover:-translate-y-px hover:bg-accent-hover hover:shadow-md disabled:opacity-60">
          {form.button}
        </button>
        <p data-form-status role="status" aria-live="polite" class="mt-3 text-sm"></p>
      </form>
    </div>
  </div>
</section>

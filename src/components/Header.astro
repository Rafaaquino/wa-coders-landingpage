---
import { locales, localePath, type Locale } from '../i18n/locales';
import { site } from '../site';

interface Props {
  lang: Locale;
  page: string;
  t: any;
}

const { lang, page, t } = Astro.props;
const home = localePath(lang);
const links = [
  { href: `${home}#services`, label: t.services },
  { href: `${home}#why`, label: t.why },
  { href: `${home}#portfolio`, label: t.portfolio },
  { href: localePath(lang, 'sap-crm/'), label: t.sap, current: page === 'sap-crm/' },
  { href: localePath(lang, 'dynamics-crm/'), label: t.dynamics, current: page === 'dynamics-crm/' },
  { href: `${home}#contact`, label: t.contact },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-container items-center justify-between gap-3 px-4 py-3 sm:px-6 md:px-10">
    <a href={home} class="flex shrink-0 items-center gap-2 font-display text-lg font-black text-ink">
      <img src={site.logo} alt="WA Coders" width="36" height="36" class="h-9 w-9" />
      <span class="max-[359px]:hidden">WA Coders</span>
    </a>

    <nav aria-label={t.main} class="hidden items-center gap-6 text-sm font-medium text-muted lg:flex">
      {
        links.map((l) => (
          <a href={l.href} class={`hover:text-ink ${l.current ? 'font-semibold text-ink' : ''}`} aria-current={l.current ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <div class="flex items-center gap-0.5 rounded-full border border-line bg-surface p-0.5" role="group" aria-label={t.language}>
        {
          locales.map((l) => (
            <a
              href={localePath(l, page)}
              hreflang={l}
              data-lang-switch={l}
              lang={l}
              aria-current={l === lang ? 'true' : undefined}
              class={`rounded-full px-2 py-1 font-mono text-[11px] font-semibold sm:px-2.5 ${l === lang ? 'bg-white text-ink shadow-sm' : 'text-muted hover:text-ink'}`}
            >
              {l.toUpperCase()}
            </a>
          ))
        }
      </div>
      <a
        href={`${home}#contact`}
        class="hidden whitespace-nowrap rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-ink shadow-sm transition hover:-translate-y-px hover:bg-accent-hover hover:shadow-md sm:inline-block"
      >
        {t.cta}
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="flex h-10 w-10 items-center justify-center rounded-lg border border-line text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.menu}
        data-open-label={t.menu}
        data-close-label={t.close}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
          <path class="menu-open" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="menu-close hidden" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label={t.main} class="hidden border-t border-line bg-white lg:hidden">
    <ul class="mx-auto flex max-w-container flex-col px-4 py-2 sm:px-6">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class={`block border-b border-line py-3 text-[15px] font-medium ${l.current ? 'text-ink' : 'text-muted'}`}>
              {l.label}
            </a>
          </li>
        ))
      }
      <li class="py-3">
        <a href={`${home}#contact`} class="block rounded-lg bg-accent px-4 py-3 text-center text-sm font-semibold text-ink">{t.cta}</a>
      </li>
    </ul>
  </nav>
</header>

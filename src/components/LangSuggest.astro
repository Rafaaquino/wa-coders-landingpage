---
import { locales, localePath, type Locale } from '../i18n/locales';
import { langSuggest } from '../i18n/lang-suggest';

interface Props { lang: Locale; page: string }
const { lang, page } = Astro.props;

// Textos e URLs de todos os idiomas ficam em data-attributes: o script escolhe o do idioma preferido.
const data = Object.fromEntries(locales.map((l) => [l, { ...langSuggest[l], url: localePath(l, page) }]));
---

<aside
  id="lang-suggest"
  hidden
  role="region"
  aria-live="polite"
  data-current={lang}
  data-options={JSON.stringify(data)}
  class="fixed bottom-5 left-4 right-24 z-40 max-w-sm rounded-xl border border-line bg-white p-4 shadow-[0_14px_40px_-12px_rgba(14,23,38,0.35)] sm:left-5 sm:right-auto"
>
  <div class="flex items-start justify-between gap-3">
    <p class="text-[14px] font-medium text-ink" data-lang-text></p>
    <button type="button" data-lang-close class="-mr-1 -mt-1 flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-md text-muted hover:text-ink">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-4 w-4"><path d="M6 6l12 12M18 6L6 18" /></svg>
      <span class="sr-only" data-lang-close-label>Close</span>
    </button>
  </div>
  <div class="mt-3 flex flex-wrap items-center gap-3">
    <a data-lang-go href="#" class="rounded-lg bg-accent px-4 py-2 text-[13px] font-semibold text-ink shadow-sm transition hover:bg-accent-hover"></a>
    <button type="button" data-lang-stay class="text-[13px] font-semibold text-muted underline underline-offset-4 hover:text-ink"></button>
  </div>
</aside>

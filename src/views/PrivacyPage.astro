---
import Layout from '../layouts/Layout.astro';
import { home, privacy } from '../i18n';
import { localePath, type Locale } from '../i18n/locales';
import { breadcrumbSchema } from '../lib/schema';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = home[lang];
const p = privacy[lang];

const schema = [
  breadcrumbSchema([
    { name: p.breadcrumb, path: localePath(lang) },
    { name: p.title, path: localePath(lang, 'privacy/') },
  ]),
  { '@type': 'WebPage', name: p.title, description: p.meta.description, inLanguage: lang },
];

/** Escapa HTML e transforma e-mails em links mailto. */
const html = (text: string) =>
  text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/([\w.+-]+@[\w-]+\.[\w.-]+[\w])/g, '<a href="mailto:$1" class="font-semibold text-ink underline decoration-accent decoration-2 underline-offset-4">$1</a>');
---

<Layout lang={lang} t={t} page="privacy/" title={p.meta.title} description={p.meta.description} schema={schema}>
  <section class="py-16 md:py-20">
    <div class="mx-auto max-w-[820px] px-6 md:px-10">
      <p class="mb-3.5 font-mono text-xs uppercase tracking-wider text-accent2">{p.updatedLabel}: {p.updated}</p>
      <h1 class="text-[2.1rem] leading-[1.15] md:text-[2.6rem]">{p.title}</h1>
      <p class="mt-5 text-[16px] leading-relaxed text-muted" set:html={html(p.intro)} />

      <nav aria-label={p.title} class="mt-8 rounded-xl border border-line bg-surface p-5">
        <ol class="grid gap-x-8 gap-y-1.5 text-[14px] sm:grid-cols-2">
          {
            p.sections.map((s: any, i: number) => (
              <li class="flex gap-2">
                <span class="font-mono text-xs leading-6 text-muted">{String(i + 1).padStart(2, '0')}</span>
                <a href={`#${s.id}`} class="text-ink hover:text-accent-text hover:underline">{s.title}</a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="mt-12 flex flex-col gap-12">
        {
          p.sections.map((s: any, i: number) => (
            <section id={s.id} class="scroll-mt-24">
              <h2 class="text-[1.4rem] leading-snug">
                <span class="mr-2 font-mono text-sm font-medium text-muted">{String(i + 1).padStart(2, '0')}</span>{s.title}
              </h2>
              {s.paragraphs?.map((txt: string) => <p class="mt-3 text-[15.5px] leading-relaxed text-ink/80" set:html={html(txt)} />)}
              {s.items && (
                <ul class="mt-3 list-disc space-y-2 pl-5 text-[15.5px] leading-relaxed text-ink/80 marker:text-accent">
                  {s.items.map((txt: string) => <li set:html={html(txt)} />)}
                </ul>
              )}
              {s.table && (
                <div class="mt-4 overflow-x-auto rounded-xl border border-line">
                  <table class="w-full min-w-[560px] border-collapse text-left text-[14px]">
                    <thead class="bg-surface">
                      <tr>{s.table.head.map((h: string) => <th scope="col" class="px-4 py-3 font-semibold text-ink">{h}</th>)}</tr>
                    </thead>
                    <tbody>
                      {s.table.rows.map((row: string[]) => (
                        <tr class="border-t border-line align-top">
                          {row.map((cell: string, c: number) => (c === 0 ? <th scope="row" class="px-4 py-3 font-medium text-ink">{cell}</th> : <td class="px-4 py-3 text-ink/80">{cell}</td>))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              {s.notes?.map((txt: string) => <p class="mt-3 text-[15.5px] leading-relaxed text-ink/80" set:html={html(txt)} />)}
            </section>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

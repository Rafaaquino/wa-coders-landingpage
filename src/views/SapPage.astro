---
import Layout from '../layouts/Layout.astro';
import SolutionHero from '../components/solution/SolutionHero.astro';
import SolutionIntro from '../components/solution/SolutionIntro.astro';
import FinanceSpotlight from '../components/solution/FinanceSpotlight.astro';
import PainPoints from '../components/solution/PainPoints.astro';
import HowItWorks from '../components/solution/HowItWorks.astro';
import Integrations from '../components/solution/Integrations.astro';
import Modules from '../components/solution/Modules.astro';
import Differentiators from '../components/solution/Differentiators.astro';
import Security from '../components/solution/Security.astro';
import Faq from '../components/Faq.astro';
import SolutionCta from '../components/solution/SolutionCta.astro';
import RelatedSolutions from '../components/solution/RelatedSolutions.astro';
import { home, sap } from '../i18n';
import { localePath, type Locale } from '../i18n/locales';
import { faqSchema, breadcrumbSchema, opportunityAppSchema } from '../lib/schema';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = home[lang];
const s = sap[lang];
const schema = [
  breadcrumbSchema([
    { name: s.breadcrumb, path: localePath(lang) },
    { name: t.nav.sap, path: localePath(lang, 'sap-crm/') },
  ]),
  opportunityAppSchema(s.meta.description, lang),
  faqSchema(s.faq.items, lang),
];
---

<Layout lang={lang} t={t} page="sap-crm/" title={s.meta.title} description={s.meta.description} schema={schema}>
  <SolutionHero t={s.hero} />
  <SolutionIntro t={s.intro} />
  <FinanceSpotlight t={s.finance} />
  <PainPoints t={s.pains} />
  <HowItWorks t={s.how} />
  <Integrations t={s.integrations} />
  <Modules t={s.modules} />
  <Differentiators t={s.diff} />
  <Security t={s.security} />
  <Faq t={s.faq} />
  <RelatedSolutions t={t.related} lang={lang} current="sap" />
  <SolutionCta t={s.cta} msgs={t.contact.form} formId="sap-form" privacyHref={localePath(lang, 'privacy/')} privacyLabel={t.footer.privacy} />
</Layout>
